          "relation": "AT_OR_ABOVE",
          "minimum": 0.55,
          "rationaleId": "c2.ghost.ocean-field-without-source"
        }
      ],
      "missingSourceFamilies": [
        "OCEAN_BASIN"
      ],
      "recommendedActions": [
        "SUPPRESS_UNSUPPORTED_OCEANIC_GHOST"
      ],
      "evidenceStatus": "PROVISIONAL",
      "limitations": [
