        "PRESERVE_DROWNED_FRAGMENT_ALTERNATIVE"
      ],
      "evidenceStatus": "PROVISIONAL",
      "limitations": [
        "Mixed radial fields cannot distinguish drowned continental affinity from transitional crust without later material and surface context."
      ]
    },
    {
      "schemaVersion": 1,
      "ruleId": "c2.ghost.oceanic",
      "risk": "OCEANIC_GHOST",
      "version": 1,
