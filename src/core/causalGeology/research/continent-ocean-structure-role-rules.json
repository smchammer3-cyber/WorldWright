    },
    {
      "schemaVersion": 1,
      "ruleId": "c2.ghost.shelf",
      "risk": "SHELF_GHOST",
      "version": 1,
      "genericClaimRuleIds": [
        "structure/shelf-slope-surface-context-v1"
      ],
      "triggerFieldSignals": [
        {
          "schemaVersion": 1,
          "fieldId": "continentalKernelInfluence",
          "relation": "AT_OR_ABOVE",
          "minimum": 0.35,
          "rationaleId": "c2.ghost.shelf-continental-affinity"
        },
        {
          "schemaVersion": 1,
          "fieldId": "oceanBasinInfluence",
          "relation": "BETWEEN_INCLUSIVE",
          "minimum": 0.15,
          "maximum": 0.65,
          "rationaleId": "c2.ghost.shelf-basin-transition"
        }
      ],
      "missingSourceFamilies": [],
      "recommendedActions": [
