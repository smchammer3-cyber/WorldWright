      "candidateTerrainTermPermissions": [
        "LATER_EXTENSIONAL_RESPONSE_TERM_CANDIDATE",
        "LATER_GRAIN_ANISOTROPY_TERM_CANDIDATE",
        "LATER_RESISTANCE_CONTRAST_TERM_CANDIDATE"
      ],
      "evidenceStatus": "RESEARCH_REQUIRED",
      "resolverDisposition": "AMBIGUITY_OR_UNRESOLVED_ONLY",
      "exceptions": [
        "Magma-rich and volcanic margins need not contain exhumed-mantle transition zones.",
        "Radial fields cannot establish detachment geometry or a mantle-exhumation corridor."
      ],
      "limitations": [
        "M1B preserves exhumed mantle only as a source-backed alternative and forbids it from leading before later geometry and material evidence exist."
      ]
