      "researchStatus": "RESEARCH_REQUIRED",
      "genericClaimRuleIds": [
        "m1a.claim.magma-poor-rifts-can-exhume-mantle-v1",
        "m1a.claim.rift-extension-thins-and-inherits-continental-lithosphere-v1"
      ],
      "requiredStructuralRoles": [
        "CONTINENTAL_MARGIN",
        "CONTINENTAL_SLOPE",
        "TRANSITIONAL_CRUST"
      ],
      "allowedFieldIds": [
        "continentalKernelInfluence",
        "oceanBasinInfluence",
        "projectionConfidence",
        "riftInfluence",
        "transformInfluence"
      ],
      "requiredSourceFamilies": [
        "CONTINENTAL_KERNEL",
        "RIFT_SYSTEM"
